# Telegram Bot Configuration
# Obtain BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Obtain CHAT_ID by messaging your bot and querying:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# System Operational Configuration
SYSTEM_MODE=DISCOVERY_MODE
MAX_APPLICATIONS_PER_DAY=10
ENABLE_EMAIL_MONITORING=false

# Candidate Profile Overrides (Optional / Can also be specified in config/candidate_profile.yaml)
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
